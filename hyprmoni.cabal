cabal-version: 3.0

name: hyprmoni
version: 0.1.0.0
license: MIT

common common-properties
    ghc-options:
        -Wall -Werror
    default-language: Haskell2010
    build-depends:
        base,
        text

executable hyprmoni
    import: common-properties
    main-is: Main.hs
    hs-source-dirs: app
    ghc-options: -threaded

    build-depends:
        hyprland-monitors

library hyprland-monitors
    import: common-properties
    hs-source-dirs: src

    exposed-modules:
        Application,
        Hyprland,
        Json,
        Monitor,
        Monitors,
        Selection,
        Types,
        UI

    build-depends:
        brick,
        bytestring,
        containers,
        network,
        vty

test-suite test
    import: common-properties
    type: exitcode-stdio-1.0
    hs-source-dirs: test
    main-is: Spec.hs

    other-modules:
        JsonSpec,
        MonitorsSpec,
        SelectionSpec

    build-depends:
        hyprland-monitors,
        hspec,
        containers

    build-tool-depends:
        hspec-discover:hspec-discover
